RequirementList REQ_Sentry
{
    myOperator OR
    myRequirements
    {
        FighterArchetypeRequirement Archetype
        {
            myArchetypeToCheck pvp_dm_luigi_deployableweapons
        }
        FighterArchetypeRequirement Archetype
        {
            myArchetypeToCheck pvp_dm_rabbidspeach_deployableweapons
        }
    }
}



string "Misc Requirement" ""

RequirementList REQ_Null
{
}

RequirementList REQ_AnySize
{
	myOperator OR
	myRequirements
	{
		FighterSizeRequirement Size
		{
		}
		FighterSizeRequirement Size
		{
			mySizeToCheck Medium
		}
		FighterSizeRequirement Size
		{
			mySizeToCheck Big
		}
		FighterSizeRequirement Size
		{
			mySizeToCheck Huge
		}
	}
}

